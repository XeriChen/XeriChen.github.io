{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xerichen-blog",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "r2-free-10g"
    }
  ],
  "routes": [
    {
      "pattern": "blog.xerichen.de5.net",
      "custom_domain": true
    }
  ]
}
